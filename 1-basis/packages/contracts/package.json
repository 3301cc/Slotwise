{
  "name": "@slotwise/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zod schemas for the internal voice API (apps/voice ⇄ apps/web) and shared enums. JSON Schema export for the Python side.",
  "exports": {
    ".": "./src/index.ts",
    "./voice": "./src/voice.ts",
    "./booking-fields": "./src/booking-fields.ts"
  },
