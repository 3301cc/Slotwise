{
  "name": "@slotwise/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-free domain logic: availability engine, booking rules, voice tool service. No runtime dependencies.",
  "exports": {
    ".": "./src/index.ts",
    "./availability": "./src/availability/engine.ts",
