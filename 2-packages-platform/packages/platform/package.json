{
  "name": "@slotwise/platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "audit:embed": "playwright test -c audit/playwright.config.ts"
  },
  "dependencies": {
    "ioredis": "^5.4.1",
    "pg": "^8.13.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.11",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "optionalDependencies": {
    "bullmq": "^5.34.0",
    "pg-boss": "^10.1.5"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config/*": "./config/*",
    "./content/*": "./content/*"
  },
  "description": "Platform layer (from the R0–R2 track): booking state machine + lifecycle, slot engine, entitlements/plans, metering, adapters (CalDAV, Jitsi, Mollie), job queues, calendar outbox + tenant alerts. Pg repositories target the platform Prisma schema (packages/platform-db). 99 tests, no DB needed."
}
