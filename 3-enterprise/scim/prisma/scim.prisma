// Ergänzung zum CalenSync-Prisma-Schema für SCIM-Provisionierung, Kill-Switch und Audit-Hash-Kette.
// Feldnamen entsprechen src/prismaStore.ts. Bestehende Modelle (Pipeline, WebhookChannel) bekommen die
// markierten Zusatzfelder.

model ScimUser {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  userName           String    @map("user_name")
  userNameNormalized String    @map("user_name_normalized")
  externalId         String?   @map("external_id")
  active             Boolean   @default(true)
  displayName        String?   @map("display_name")
  givenName          String?   @map("given_name")
  familyName         String?   @map("family_name")
  formattedName      String?   @map("formatted_name")
  emails             Json      @default("[]")
  department         String?
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @map("updated_at")
  deprovisionedAt    DateTime? @map("deprovisioned_at")
  /// SCIM DELETE: Tombstone ohne PII bis zum erfolgreichen Provider-Teardown; danach purgeDeletedUser
  deletionRequestedAt DateTime? @map("deletion_requested_at")

  pipelines Pipeline[]
  tokens    ProviderToken[]

  @@unique([tenantId, userNameNormalized])
  @@unique([tenantId, externalId])
  @@index([tenantId, active])
  @@index([tenantId, deletionRequestedAt])
  @@map("scim_users")
}

/// Verschlüsselte Provider-Refresh-Tokens (nur bei delegiertem OAuth; im Admin-Consent-Modell leer).
/// ciphertext = AES-256-GCM(dataKey), dataKey = KMS-verschlüsselt mit alias/<tenant>-tokens.
model ProviderToken {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  userId           String   @map("user_id")
  provider         String
  ciphertext       Bytes
  encryptedDataKey Bytes    @map("encrypted_data_key")
  createdAt        DateTime @default(now()) @map("created_at")

  user ScimUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, provider])
  @@map("provider_tokens")
}

