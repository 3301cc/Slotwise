/// Manipulationsevidentes Audit-Log (Hash-Kette je Mandant). Keine UPDATE/DELETE-Rechte für die App-Rolle:
///   REVOKE UPDATE, DELETE ON audit_events FROM calensync_app;
model AuditEvent {
  seq          BigInt   @id @default(autoincrement())
  tenantId     String   @map("tenant_id")
  requestId    String   @map("request_id")
  actor        String
  action       String
  targetUserId String?  @map("target_user_id")
  outcome      String
  detail       Json
  at           DateTime
  prevHash     String   @map("prev_hash")
  hash         String   @unique

  @@index([tenantId, seq])
  @@map("audit_events")
}
